#!ipxe
# Tiaris Nest second-stage handoff for the package-provided iPXE launchers.
# ProxyDHCP owns the boot server; the address server may also set next-server.
dhcp net0 || goto tiaris_retry
set tiaris-boot-server ${next-server}
isset ${proxydhcp/next-server} && set tiaris-boot-server ${proxydhcp/next-server} ||
isset ${pxebs/next-server} && set tiaris-boot-server ${pxebs/next-server} ||
isset ${tiaris-boot-server} || goto tiaris_failed
isset ${net0/mac} || goto tiaris_failed
set tiaris-local-handoff 0
chain --autofree http://${tiaris-boot-server}/boot/${net0/mac:hexhyp} || goto tiaris_first_chain_failed
goto tiaris_end

:tiaris_first_chain_failed
iseq ${tiaris-local-handoff} 1 && goto tiaris_local_handoff || goto tiaris_retry

:tiaris_retry
sleep 2
dhcp net0 || goto tiaris_failed
set tiaris-boot-server ${next-server}
isset ${proxydhcp/next-server} && set tiaris-boot-server ${proxydhcp/next-server} ||
isset ${pxebs/next-server} && set tiaris-boot-server ${pxebs/next-server} ||
isset ${tiaris-boot-server} || goto tiaris_failed
isset ${net0/mac} || goto tiaris_failed
set tiaris-local-handoff 0
chain --autofree http://${tiaris-boot-server}/boot/${net0/mac:hexhyp} || goto tiaris_second_chain_failed
goto tiaris_end

:tiaris_second_chain_failed
iseq ${tiaris-local-handoff} 1 && goto tiaris_local_handoff || goto tiaris_failed

:tiaris_local_handoff
exit 1

:tiaris_failed
echo Tiaris Nest could not load this workstation boot request
sleep 5
exit 1

:tiaris_end
