#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

control_dir=/var/lib/tiaris-nest/control
approved="$control_dir/netplan-approved.json"
fallback="$control_dir/netplan-dhcp-fallback.json"
active=/etc/netplan/90-tiaris-nest.yaml
plan="$control_dir/install-plan.json"
test -s "$approved" && test -s "$fallback" && test -s "$plan"

install -m 0600 "$approved" "$active"
/usr/lib/tiaris-nest/tiaris-nest-netplan-activate
origin="$(jq -er '.manage_origin' "$control_dir/provisioning-state.json")"
required_origin="$(/usr/lib/tiaris-nest/tiaris-nest-bootstrap required-manage-origin)"
test "$origin" = "$required_origin"

# Activation makes networkd reconfigure the link even for an unchanged profile:
# the DHCP lease, route and resolver are briefly dropped and re-acquired, so a
# single immediate request can fail during that reset. Retry until the bounded
# deadline, which keeps the budget the single request previously had.
management_reachable() {
  local deadline=$((SECONDS + $1)) remaining
  while remaining=$((deadline - SECONDS)); ((remaining > 0)); do
    if timeout "$remaining" curl --fail --silent --show-error --proto '=https' --tlsv1.2 \
      --connect-timeout 10 --output /dev/null "$origin/healthz"; then
      return 0
    fi
    sleep 1
  done
  return 1
}

if management_reachable 30; then
  # A failed live-change rollback deliberately preserves these root-owned
  # recovery artifacts. Once boot has reactivated the approved profile and
  # reached Management, their evidence is no longer needed.
  rm -f "$control_dir/network-fallback-active" \
    "$control_dir/netplan-pending.sha256" \
    "$control_dir/netplan-before-change.yaml"
  sync -f "$control_dir"
  exit 0
fi

dhcp4="$(jq -r '.network.ethernets["tiaris-nest"].dhcp4 | if type == "boolean" then tostring else error("invalid approved DHCP mode") end' "$approved")"
if [[ "$dhcp4" != false ]]; then
  echo "error: DHCP could not reach Tiarisment" >&2
  exit 1
fi
install -m 0600 "$fallback" "$active"
/usr/lib/tiaris-nest/tiaris-nest-netplan-activate
approved_sha256="$(sha256sum "$approved" | awk '{print $1}')"
[[ "$approved_sha256" =~ ^[0-9a-f]{64}$ ]]
marker="$(mktemp "$control_dir/.network-fallback-active.XXXXXX")"
jq -n --arg approved_sha256 "$approved_sha256" \
  '{schema:"tiaris.nest.network-fallback.v1",approved_sha256:$approved_sha256}' \
  > "$marker"
chmod 0600 "$marker"
chown root:root "$marker"
sync -f "$marker"
mv -f "$marker" "$control_dir/network-fallback-active"
sync -f "$control_dir"
management_reachable 60
# DHCP is now the verified active recovery profile. Retain its authenticated
# selector, but clear any failed live-change transaction so a later signed
# correction with a different digest is not rejected as a conflicting resume.
rm -f "$control_dir/netplan-pending.sha256" \
  "$control_dir/netplan-before-change.yaml"
sync -f "$control_dir"
