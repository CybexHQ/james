#!/usr/bin/env python3
"""Only a root-verified signed policy can authorize an update: Update now, the
Nest being idle (mode when_idle) or the maintenance window (mode window, and
every schema v1 policy). Exit 0 allows it; exit 75 prints what it waits for."""
import datetime
import json
from pathlib import Path
import subprocess
import sys
from zoneinfo import ZoneInfo
from appliance_state import CONTROL, INBOX, UID, load, run

# The daemon serves every boot, install and cache request and writes this.
ACTIVITY = Path('/run/tiaris-nest/activity.json')
QUIET_SECONDS = 10 * 60
# A report older than this means the daemon serves nothing at all.
STALE_SECONDS = 3 * 60
# Without a report, give a freshly started Nest time to start its daemon.
UNREPORTED_UPTIME_SECONDS = 30 * 60


def in_window(schedule, now):
    local = now.astimezone(ZoneInfo(schedule['timezone']))
    current_minute = ((local.weekday() + 1) % 7) * 1440 + local.hour * 60 + local.minute
    hour, minute = map(int, schedule['start'].split(':'))
    return any((current_minute - day * 1440 - hour * 60 - minute) % 10080 < schedule['duration_minutes'] for day in schedule['weekdays'])


def uptime_seconds():
    return float(Path('/proc/uptime').read_text().split()[0])


def timestamp(value):
    parsed = datetime.datetime.strptime(value, '%Y-%m-%dT%H:%M:%SZ')
    return parsed.replace(tzinfo=datetime.timezone.utc)


def idle(now, activity=ACTIVITY, uptime=uptime_seconds):
    """Idle once nothing kept the Nest busy for QUIET_SECONDS. A missing or
    stale report fails closed until the Nest has run for a while."""
    try:
        report = load(activity, owner=UID, maximum=4 * 1024)
        if report['schema'] != 'tiaris.nest.activity.v1' or not isinstance(report['busy'], list):
            raise ValueError('unknown activity report')
        age = (now - timestamp(report['written_at'])).total_seconds()
        since = report['idle_since']
        since = None if since is None else timestamp(since)
    except (OSError, ValueError, KeyError, TypeError):
        return uptime() >= UNREPORTED_UPTIME_SECONDS
    if not -60 <= age <= STALE_SECONDS:
        return uptime() >= UNREPORTED_UPTIME_SECONDS
    return not report['busy'] and since is not None and (now - since).total_seconds() >= QUIET_SECONDS


def waiting_for(policy, request, now, is_idle=idle):
    """None when the update may start, else the status stage it waits in."""
    immediate = policy.get('run_now')
    release = request['release']
    if immediate and (immediate['attempt_id'] == request['attempt_id']
            and immediate['release_id'] == release['release_id']
            and immediate['system_closure_sha256'] == release['system_closure']['sha256']):
        return None
    if policy.get('mode', 'window') == 'when_idle':
        return None if is_idle(now) else 'nest_busy'
    return None if in_window(policy['schedule'], now) else 'maintenance_window'


def allowed(policy, request, now, is_idle=idle):
    return waiting_for(policy, request, now, is_idle) is None


def main():
    if not (INBOX / 'update-schedule.json').exists() and not (CONTROL / 'update-schedule.json').exists():
        print('maintenance_window')
        return 75
    verified = run('/usr/bin/tiaris-nest', 'verify-appliance-update-policy')
    if verified != str(CONTROL / 'update-schedule.json'):
        raise ValueError('invalid verified policy path')
    policy = load(Path(verified), maximum=64 * 1024)
    if policy.get('mode', 'window') not in ('when_idle', 'window'):
        raise ValueError('unknown update mode')
    request = load(INBOX / 'appliance-update-request.json', owner=UID)
    waiting = waiting_for(policy, request, datetime.datetime.now(datetime.timezone.utc))
    if waiting is None:
        return 0
    print(waiting)
    return 75


if __name__ == '__main__':
    sys.exit(main())
