{
  "schema": "tiaris.component-compatibility.v2",
  "protocol_version": 4,
  "manage": {
    "minimum_nest_protocol": 4,
    "maximum_nest_protocol": 5
  },
  "nest": {
    "minimum_manage_protocol": 4,
    "maximum_manage_protocol": 4
  },
  "workstation_runtime": {
    "compatibility_epoch": 1,
    "descriptor_schema": "tiaris.nest.workstation-netboot.v1",
    "manifest_schema": "tiaris.nest.workstation-netboot-manifest.v1",
    "architecture": "x86_64-linux",
    "format": "split-squashfs-v1",
    "required_nest_protocol": 4,
    "import_states": [
      "absent",
      "queued",
      "downloading",
      "verifying",
      "extracting",
      "ready",
      "failed",
      "held"
    ],
    "import_error_codes": [
      "invalid_descriptor",
      "integrity_mismatch",
      "insufficient_disk_space",
      "network_or_server",
      "local_io_or_processing",
      "compatibility_epoch_unsupported",
      "unknown"
    ],
    "resolution_states": [
      "ready",
      "using_last_known_good",
      "unavailable",
      "not_configured"
    ],
    "resolution_error_codes": [
      "release_unavailable",
      "runtime_missing",
      "descriptor_invalid",
      "compatibility_epoch_unsupported",
      "trust_invalid",
      "rollback_rejected",
      "storage_unavailable",
      "internal_error"
    ],
    "report_receipt_states": [
      "accepted",
      "rejected",
      "unavailable"
    ],
    "report_receipt_error_codes": [
      "runtime_report_missing",
      "runtime_report_invalid",
      "runtime_report_stale",
      "runtime_report_storage_unavailable"
    ]
  },
  "component_floors": {
    "nest": {
      "appliance_release_schema": "tiaris.nest.appliance-release.v3"
    },
    "workstation_runtime": {
      "installer_target_minimum": "1.0.15",
      "managed_update_minimum": "1.0.27"
    },
    "features": {
      "classroom-gnome-taskbar-dock": {
        "workstation_runtime_minimum": "1.0.98",
        "classroom_browser_minimum": "0.2.2"
      }
    }
  },
  "signed_artifacts": [
    {
      "component": "nest_binary",
      "carried_by": "tiaris.nest.release.v1",
      "signature_domain": null
    },
    {
      "component": "nest_appliance",
      "schema": "tiaris.nest.appliance-release.v3",
      "signature_domain": "TIARIS-NEST-APPLIANCE-RELEASE-V3"
    },
    {
      "component": "nest_appliance_iso",
      "signature_domain": "TIARIS-NEST-INSTALLER-ISO-TEMPLATE-V3"
    },
    {
      "component": "workstation_runtime",
      "schema": "tiaris.nest.workstation-netboot.v1",
      "signature_domain": "TIARIS-NEST-WORKSTATION-NETBOOT-V1"
    },
    {
      "component": "release_compatibility",
      "schema": "tiaris.nest.release-compatibility.v1",
      "signature_domain": "TIARIS-NEST-RELEASE-COMPATIBILITY-V1"
    },
    {
      "component": "classroom_browser",
      "kind": "crx3",
      "authority": "organization"
    }
  ]
}
