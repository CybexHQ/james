#cloud-config
autoinstall:
  version: 1
  interactive-sections: []
  refresh-installer:
    update: false
  early-commands:
    - /cdrom/tiaris/bootstrap/tiaris-nest-bootstrap prepare --envelope /cdrom/TIARIS_PROVISIONING.BIN --provisioning-keys /cdrom/tiaris/provisioning-public-keys --autoinstall /autoinstall.yaml --state-mount /run/tiaris-state
  error-commands:
    - /bin/sh -c 'journalctl -b --no-pager -n 500 | tee /run/tiaris-installer-error.log /dev/tty0 /dev/ttyS0 >/dev/null || true'
  shutdown: reboot
