[Unit]
Description=Commit a healthy Tiaris Nest root generation
After=network-online.target tiaris-nest.service nginx.service tftpd-hpa.service nix-daemon.service
Wants=network-online.target tiaris-nest.service nginx.service tftpd-hpa.service nix-daemon.service
ConditionPathExists=/var/lib/tiaris-nest/control/pending-root-generation.json

[Service]
Type=oneshot
ExecStart=/usr/lib/tiaris-nest/tiaris-nest-generation-commit
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
