[Unit]
Description=Cybex Pulse managed appliance service
After=network-online.target nix-daemon.service nginx.service tftpd-hpa.service cybex-pulse-first-boot.service cybex-pulse-network-runtime.service
Wants=network-online.target nginx.service tftpd-hpa.service
Requires=cybex-pulse-first-boot.service cybex-pulse-network-runtime.service
RequiresMountsFor=/var/lib/cybex-pulse/state /var/cache/cybex-pulse /nix
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=30s
User=cybex-pulse
Group=cybex-pulse
ExecStart=/usr/bin/cybex-pulse --config /etc/cybex-pulse/config.toml serve
WorkingDirectory=/var/lib/cybex-pulse
Environment=HOME=/var/cache/cybex-pulse/agent/home
Environment=XDG_CACHE_HOME=/var/cache/cybex-pulse/agent/cache
Environment=XDG_CONFIG_HOME=/var/cache/cybex-pulse/agent/config
Environment=XDG_STATE_HOME=/var/cache/cybex-pulse/agent/state
Environment=TMPDIR=/var/cache/cybex-pulse/agent/tmp
# Do not let writable per-service configuration relax the reviewed Nix client
# policy. NIX_CONFIG and command-line options remain the only inputs.
Environment=NIX_USER_CONF_FILES=/dev/null
Restart=always
RestartSec=3s
UMask=0077
ReadWritePaths=/var/lib/cybex-pulse /var/cache/cybex-pulse
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
