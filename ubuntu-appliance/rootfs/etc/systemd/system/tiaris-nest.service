[Unit]
Description=Tiaris Nest managed appliance service
After=network-online.target nix-daemon.service nginx.service tftpd-hpa.service tiaris-nest-first-boot.service tiaris-nest-network-runtime.service
Wants=network-online.target nginx.service tftpd-hpa.service
Requires=tiaris-nest-first-boot.service tiaris-nest-network-runtime.service
RequiresMountsFor=/var/lib/tiaris-nest/state /var/cache/tiaris-nest /nix
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=30s
User=tiaris-nest
Group=tiaris-nest
ExecStart=/usr/bin/tiaris-nest --config /etc/tiaris-nest/config.toml serve
WorkingDirectory=/var/lib/tiaris-nest
Environment=HOME=/var/cache/tiaris-nest/agent/home
Environment=XDG_CACHE_HOME=/var/cache/tiaris-nest/agent/cache
Environment=XDG_CONFIG_HOME=/var/cache/tiaris-nest/agent/config
Environment=XDG_STATE_HOME=/var/cache/tiaris-nest/agent/state
Environment=TMPDIR=/var/cache/tiaris-nest/agent/tmp
# Do not let writable per-service configuration relax the reviewed Nix client
# policy. NIX_CONFIG and command-line options remain the only inputs.
Environment=NIX_USER_CONF_FILES=/dev/null
Restart=always
RestartSec=3s
UMask=0077
ReadWritePaths=/var/lib/tiaris-nest /var/cache/tiaris-nest
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
