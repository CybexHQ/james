[Unit]
Description=Commit a healthy Cybex Pulse root generation
After=network-online.target cybex-pulse.service nginx.service tftpd-hpa.service nix-daemon.service
Wants=network-online.target cybex-pulse.service nginx.service tftpd-hpa.service nix-daemon.service
ConditionPathExists=/var/lib/cybex-pulse/control/pending-root-generation.json

[Service]
Type=oneshot
ExecStart=/usr/lib/cybex-pulse/cybex-pulse-generation-commit
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
