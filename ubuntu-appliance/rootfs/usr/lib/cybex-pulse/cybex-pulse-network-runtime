#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

result="$(/usr/lib/cybex-pulse/cybex-pulse-bootstrap reconcile-network-runtime)"
case "$result" in
  unchanged|changed) ;;
  *)
    echo "network runtime reconciliation returned an invalid outcome" >&2
    exit 1
    ;;
esac

pulse_state="$(systemctl show --property=ActiveState --value cybex-pulse.service)"
case "$pulse_state" in
  active)
    if [[ "$result" = changed ]]; then
      # Queue rather than wait on the unit ordered after this prerequisite.
      systemctl --no-block try-restart cybex-pulse.service
    fi
    ;;
  inactive|failed)
    # A failed initial prerequisite leaves Pulse down. A later successful timer
    # reconciliation must make the appliance self-heal without operator input.
    systemctl --no-block start cybex-pulse.service
    ;;
  activating|deactivating|reloading)
    # Pulse already has a converging job. Starting it again from its own
    # prerequisite would create a needless transaction loop.
    ;;
  *)
    echo "Pulse service returned an invalid ActiveState" >&2
    exit 1
    ;;
esac
