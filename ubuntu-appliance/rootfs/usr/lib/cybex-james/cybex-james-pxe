#!/usr/bin/python3
"""Appliance-owned IPv4 PXE proxy supervisor. Never allocates DHCP leases.

Only a complete authenticated Manage inventory can arm discovery. Peer election
requires direct-link MAC evidence, not matching prefixes on unrelated VLANs.
"""
from __future__ import annotations
import concurrent.futures
import hashlib
import http.client
import ipaddress
import json
import os
from pathlib import Path
import re
import signal
import stat
import subprocess
import sys
import time
import tomllib

RUN = Path('/run/cybex-james-pxe')
CONTROL = Path('/var/lib/cybex-james/control')
CONFIG = Path('/etc/cybex-james/config.toml')
POLICY = Path('/etc/cybex-james/pxe-discovery.json')
SCHEMA = 'cybex.james.pxe-discovery.v1'
MAX_AGE = 300
INTERVAL = 5
STOP = False

class Unavailable(Exception):
    pass

def require(condition, reason):
    if not condition:
        raise Unavailable(reason)

def bounded(path, limit=2 * 1024 * 1024, *, root=False):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as stream:
        info = os.fstat(stream.fileno())
        require(stat.S_ISREG(info.st_mode) and info.st_nlink == 1, 'unsafe_state_file')
        if root:
            require(info.st_uid == 0 and not info.st_mode & 0o022, 'unsafe_configuration')
        value = stream.read(limit + 1)
    require(len(value) <= limit, 'inventory_too_large')
    return value

def read_json(path, **kwargs):
    return json.loads(bounded(path, **kwargs))

def run(args):
    result = subprocess.run(args, capture_output=True, timeout=4, check=False)
    require(result.returncode == 0 and len(result.stdout) <= 2 * 1024 * 1024, 'network_probe_failed')
    return result.stdout

def atomic(path, value):
    data = (json.dumps(value, separators=(',', ':')) + '\n').encode()
    temporary = path.with_suffix('.new')
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, 'wb') as stream:
        stream.write(data)
    os.replace(temporary, path)

def mac(value):
    require(isinstance(value, str) and re.fullmatch(r'[0-9a-f]{2}(?::[0-9a-f]{2}){5}', value), 'invalid_mac')
    require(int(value[:2], 16) & 1 == 0 and value != '00:00:00:00:00:00', 'invalid_mac')
    return value

def identity(value):
    require(isinstance(value, str) and re.fullmatch(r'[A-Za-z0-9_-]{1,128}', value), 'invalid_identity')
    return value

def address(value):
    ip = ipaddress.IPv4Address(value)
    require(not (ip.is_loopback or ip.is_unspecified or ip.is_multicast or ip.is_link_local or str(ip) == '255.255.255.255'), 'invalid_address')
    return ip

def network_from(plan, interfaces, actual_mac):
    network = plan.get('network', {})
    require(network.get('version') == 2 and network.get('renderer') == 'networkd', 'network_plan_invalid')
    devices = network.get('ethernets', {})
    require(list(devices) == ['cybex-james'], 'network_plan_invalid')
    nic = devices['cybex-james']
    name = nic.get('set-name', '')
    require(re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', name) and name != 'lo', 'network_plan_invalid')
    expected_mac = mac(nic.get('match', {}).get('macaddress', '').lower())
    require(expected_mac == actual_mac, 'interface_identity_changed')
    require(len(interfaces) == 1 and interfaces[0].get('ifname') == name, 'interface_unavailable')
    require('UP' in interfaces[0].get('flags', []) and 'LOWER_UP' in interfaces[0].get('flags', []), 'interface_unavailable')
    candidates = []
    for item in interfaces[0].get('addr_info', []):
        if item.get('family') != 'inet' or item.get('scope') != 'global' or item.get('preferred_life_time') == 0:
            continue
        if set(item.get('flags', [])) & {'secondary', 'tentative', 'dadfailed', 'deprecated'}:
            continue
        ip = address(item['local'])
        prefix = item.get('prefixlen')
        require(isinstance(prefix, int) and 1 <= prefix <= 30, 'subnet_unsupported')
        candidates.append(ipaddress.IPv4Interface(f'{ip}/{prefix}'))
    if nic.get('dhcp4') is True:
        require(not nic.get('addresses') and len(candidates) == 1, 'address_ambiguous')
        selected = candidates[0]
    else:
        require(len(nic.get('addresses', [])) == 1, 'network_plan_invalid')
        selected = ipaddress.IPv4Interface(nic['addresses'][0])
        require(selected in candidates, 'approved_address_unavailable')
    require(selected.ip not in (selected.network.network_address, selected.network.broadcast_address), 'invalid_address')
    return {'interface': name, 'mac': expected_mac, 'address': str(selected.ip), 'cidr': str(selected.network)}

def current_network():
    raw = bounded(CONTROL / 'netplan-approved.json', root=True)
    marker = CONTROL / 'network-fallback-active'
    if marker.exists():
        fallback = read_json(marker, limit=256, root=True)
        require(fallback.get('schema') == 'cybex.james.network-fallback.v1', 'network_plan_invalid')
        digest = fallback.get('approved_sha256', '')
        require(re.fullmatch('[0-9a-f]{64}', digest), 'network_plan_invalid')
        if digest == hashlib.sha256(raw).hexdigest():
            raw = bounded(CONTROL / 'netplan-dhcp-fallback.json', root=True)
    plan = json.loads(raw)
    name = plan.get('network', {}).get('ethernets', {}).get('cybex-james', {}).get('set-name', '')
    require(re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', name), 'network_plan_invalid')
    actual_mac = Path('/sys/class/net', name, 'address').read_text().strip().lower()
    interfaces = json.loads(run(['/usr/sbin/ip', '-j', '-4', 'address', 'show', 'dev', name]))
    return network_from(plan, interfaces, actual_mac)

def validate_desired(wrapper, now):
    received = wrapper.get('received_at')
    require(type(received) is int and 0 <= now - received <= MAX_AGE, 'inventory_stale')
    desired = wrapper.get('desired')
    require(isinstance(desired, dict) and desired.get('schema') == SCHEMA, 'inventory_unavailable')
    require(desired.get('complete') is True, 'inventory_incomplete')
    identity(desired.get('server_device_id'))
    peers = desired.get('peers')
    clients = desired.get('clients')
    require(isinstance(peers, list) and len(peers) <= 128 and isinstance(clients, list) and len(clients) <= 8192, 'inventory_too_large')
    ids = set()
    for peer in peers:
        key = identity(peer.get('server_device_id'))
        ip = str(address(peer.get('address')))
        hardware = mac(peer.get('mac'))
        require(key not in ids, 'peer_inventory_ambiguous')
        ids.add(key)
        require(peer.get('bootloader_filename') in ('snponly.efi', 'ipxe.efi') and type(peer.get('proxy_capable')) is bool, 'peer_inventory_invalid')
    seen = set()
    for client in clients:
        hardware = mac(client.get('mac'))
        require(hardware not in seen, 'client_inventory_ambiguous')
        seen.add(hardware)
        if client.get('server_device_id') is not None:
            identity(client['server_device_id'])
    return desired

def http_json(ip, source, legacy=False):
    connection = http.client.HTTPConnection(ip, 80, timeout=2, source_address=(source, 0))
    try:
        connection.request('GET', '/healthz' if legacy else '/healthz/pxe', headers={'Connection':'close'})
        response = connection.getresponse()
        require(response.status == 200, 'peer_unavailable')
        body = response.read(1025)
        require(len(body) <= 1024, 'peer_unavailable')
        if legacy: return {'ready': body == b'ok\n', 'eligible':False}
        result = json.loads(body)
        require(result.get('schema') == 'cybex.james.pxe-candidate.v1', 'peer_unavailable')
        return result
    finally:
        connection.close()

def peer_probe(peer, network):
    try:
        ip = peer['address']
        require(ipaddress.IPv4Address(ip) in ipaddress.IPv4Network(network['cidr']), 'peer_not_local')
        routes = json.loads(run(['/usr/sbin/ip', '-j', 'route', 'get', ip, 'from', network['address']]))
        require(len(routes) == 1 and routes[0].get('dev') == network['interface'] and not routes[0].get('gateway'), 'peer_not_local')
        result = http_json(ip, network['address'], legacy=not peer['proxy_capable'])
        expected = hashlib.sha256(peer['server_device_id'].encode()).hexdigest()
        require(not peer['proxy_capable'] or result.get('identity') == expected, 'peer_identity_changed')
        neighbors = json.loads(run(['/usr/sbin/ip', '-j', 'neigh', 'show', 'to', ip, 'dev', network['interface']]))
        require(any(row.get('lladdr', '').lower() == peer['mac'] and not set(row.get('state', [])) & {'FAILED', 'INCOMPLETE'} for row in neighbors), 'peer_identity_changed')
        return peer['server_device_id'], result
    except (Unavailable, OSError, ValueError, KeyError, subprocess.TimeoutExpired, http.client.HTTPException):
        return peer['server_device_id'], {'ready': False, 'eligible': False}

def choose(desired, network, observations):
    own = desired['server_device_id']
    peers = {peer['server_device_id']: dict(peer) for peer in desired['peers']}
    require(own in peers, 'awaiting_appliance_report')
    # The live approved interface wins over a prior report after DHCP renewal.
    peers[own].update(address=network['address'], mac=network['mac'], proxy_capable=True)
    eligible = sorted(key for key, peer in peers.items() if peer['proxy_capable'] and observations.get(key, {}).get('eligible') is True)
    require(eligible, 'boot_service_unavailable')
    winner = eligible[0]
    targets = {key: peer for key, peer in peers.items() if observations.get(key, {}).get('ready') is True}
    return winner, peers[winner], targets

def dnsmasq_config(network, default, targets, clients):
    subnet = ipaddress.IPv4Network(network['cidr'])
    lines = ['# Generated by Cybex James; no address allocation or DNS service.',
             'port=0', 'leasefile-ro', 'bind-interfaces', f"interface={network['interface']}", 'except-interface=lo',
             'user=dnsmasq', 'group=nogroup', 'pid-file=', 'log-facility=-',
             'dhcp-no-override', f'dhcp-range={subnet.network_address},proxy,{subnet.netmask}',
             'dhcp-match=set:uefi64,option:client-arch,7',
             'dhcp-match=set:uefi64,option:client-arch,9',
             'dhcp-ignore=tag:!uefi64', 'dhcp-ignore=tag:blocked']
    def service(tag, target):
        filename, ip = target['bootloader_filename'], target['address']
        for arch in (7, 9):
            lines.append(f'pxe-service=tag:{tag},{arch},"Cybex James",{filename},{ip}')
        lines.append(f'dhcp-boot=tag:{tag},{filename},,{ip}')
    service('!known', default)
    tags = {key: f'owner{index}' for index, key in enumerate(sorted(targets))}
    for key, tag in tags.items():
        service(tag, targets[key])
    for client in clients:
        tag = tags.get(client['server_device_id'], 'blocked')
        lines.append(f"dhcp-host={client['mac']},set:known,set:{tag}")
    return '\n'.join(lines) + '\n'

class Supervisor:
    def __init__(self):
        self.process = None
        self.config = None
        self.last_reason = None
        self.winner = None
        self.winner_since = 0.0
        self.identity = None
        self.retry_after = 0.0

    def stop(self):
        if self.process is not None:
            self.process.terminate()
            try: self.process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                self.process.kill(); self.process.wait(timeout=3)
        self.process = None
        self.config = None

    def status(self, state, reason, eligible=False):
        atomic(RUN / 'status.json', {'schema':'cybex.james.pxe-status.v1', 'checked_at':int(time.time()),
               'status':state, 'reason':reason, 'eligible':eligible, 'identity':self.identity})
        if self.last_reason != (state, reason):
            print(f'PXE discovery: {state} ({reason})', flush=True)
            self.last_reason = (state, reason)

    def failed(self, error):
        self.stop()
        reason = str(error) if isinstance(error, Unavailable) else 'supervisor_error'
        if reason in ('proxy_process_failed', 'proxy_configuration_invalid'):
            # Withdraw candidacy long enough for another appliance to take over.
            self.retry_after = time.monotonic() + 30
            self.winner = None
        self.status('unavailable', reason)

    def reconcile(self):
        policy = read_json(POLICY, limit=4096, root=True) if POLICY.exists() else {'mode':'automatic'}
        require(policy in ({'mode':'automatic'}, {'mode':'external'}), 'local_policy_invalid')
        if policy['mode'] == 'external':
            self.stop(); self.status('external', 'external_dhcp_selected'); return
        if time.monotonic() < self.retry_after:
            self.status('unavailable', 'proxy_retry_pending'); return
        config = tomllib.loads(bounded(CONFIG, root=True).decode())
        state_path = Path(config['manage']['state_path'])
        require(str(state_path.parent) in ('/var/lib/cybex-james/state/agent', '/var/lib/cybex-james/state'), 'unsafe_state_path')
        desired = validate_desired(read_json(state_path.parent / 'pxe-discovery.json'), int(time.time()))
        network = current_network()
        self.identity = hashlib.sha256(desired['server_device_id'].encode()).hexdigest()
        # Publish candidacy before polling to let simultaneous starters converge.
        previous = self.last_reason if self.last_reason and self.last_reason[0] in ('active', 'standby') else ('starting', 'electing_responder')
        self.status(*previous, eligible=True)
        own = desired['server_device_id']
        observations = {}
        # Readiness checks only the boot path, never this supervisor (no cycle).
        local = http_json(network['address'], network['address'])
        observations[own] = {'ready': local.get('ready') is True, 'eligible': local.get('ready') is True}
        peers = [peer for peer in desired['peers'] if peer['server_device_id'] != own]
        with concurrent.futures.ThreadPoolExecutor(max_workers=16) as executor:
            for key, observation in executor.map(lambda p: peer_probe(p, network), peers):
                observations[key] = observation
        winner, default, targets = choose(desired, network, observations)
        if winner != self.winner:
            self.winner, self.winner_since = winner, time.monotonic()
            self.stop()
        if winner != own:
            self.stop(); self.status('standby', 'peer_responder_active', True); return
        # Delay initial activation/takeover so lower-ranked peers can be observed.
        if time.monotonic() - self.winner_since < 2 * INTERVAL:
            self.stop(); self.status('starting', 'electing_responder', True); return
        text = dnsmasq_config(network, default, targets, desired['clients'])
        if self.process is not None and self.process.poll() is not None:
            self.stop()
            raise Unavailable('proxy_process_failed')
        if text != self.config:
            self.stop()
            path = RUN / 'dnsmasq.conf'
            path.write_text(text)
            # Parse before binding any network socket; no shell or user options.
            result = subprocess.run(['/usr/sbin/dnsmasq', '--test', f'--conf-file={path}'], capture_output=True, timeout=4)
            require(result.returncode == 0, 'proxy_configuration_invalid')
            self.process = subprocess.Popen(['/usr/sbin/dnsmasq', '--keep-in-foreground', f'--conf-file={path}'])
            time.sleep(0.1)
            require(self.process.poll() is None, 'proxy_process_failed')
            self.config = text
        self.status('active', 'proxy_ready', True)

def main():
    global STOP
    require(os.geteuid() == 0, 'root_required')
    RUN.mkdir(mode=0o755, parents=True, exist_ok=True)
    require(RUN.stat().st_uid == 0 and not RUN.is_symlink(), 'unsafe_state_path')
    supervisor = Supervisor()
    def stop_signal(signum, frame):
        global STOP
        STOP = True
    signal.signal(signal.SIGTERM, stop_signal)
    signal.signal(signal.SIGINT, stop_signal)
    try:
        while not STOP:
            try:
                supervisor.reconcile()
            except Exception as error:
                supervisor.failed(error)
            deadline = time.monotonic() + INTERVAL
            while not STOP and time.monotonic() < deadline:
                time.sleep(0.2)
    finally:
        supervisor.stop()
        supervisor.status('unavailable', 'supervisor_stopped')

if __name__ == '__main__':
    main()
