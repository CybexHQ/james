#!/usr/bin/python3
"""Retire only the known September development daemon overrides on upgrade.

This runs inside the new root generation during package configuration. The
previous root and shared James identity/database are untouched. Other operator
overrides remain authoritative.
"""
import hashlib
import os
from pathlib import Path
import stat

KNOWN = {
    "6fe76ff5a1295f7b7352b3cfbb65251cc66c129120fc254fe2673a4953110037": (
        "opt/cybex-james-dev/verification-fix-20260914/cybex-james",
        {"1262e01060c81e478e69aa0f06b62dc8d545dd17e63d70e459261b821bbdbad9",
         "f2eeb14ff20db2cde00c16deda95dac2619e4bea9d8877d5b3d9c2da074d0a37"},
    ),
    "810378844749f04248bc5b241ce73bc4ad36907495ec0e10e1337158f6cb51f1": (
        "opt/cybex-james-dev/verification-fix-20260914-dev21/cybex-james",
        {"f2eeb14ff20db2cde00c16deda95dac2619e4bea9d8877d5b3d9c2da074d0a37"},
    ),
}


# These predecessor daemons reject the candidate migration ledger on rollback.
# Stop package configuration before first candidate boot unless repaired.
UNSAFE_PREDECESSORS = {'0e3a82f56f87efa899640821d6e9dc5129eb46ace10b807fdb9b1007b46a29c6', '77a85982f5110d92db96785706343f26f0dba9666bc53241a2cce0dc85a08b6b'}

PXE_BINARY = "ec1d0994404b49690c7daed14e7af2c7364989ebeb3992a5723e8826a4c265b7"
PXE_ASSET = "db00c530c1080309944613e07a6662d9f5f7d3d5792d11ff46bd536bbd71e9f9"
PXE = {
    "etc/systemd/system/cybex-james.service.d/90-pxe-dev.conf": (
        "d8bfdf4fc8eb68af80b8ce4e735b3fd80dc982b12032137fcf9a98a5e7ce2403",
        {"opt/cybex-pxe-dev/cybex-james": PXE_BINARY,
         "opt/cybex-pxe-dev/autoexec.ipxe": PXE_ASSET},
    ),
    "etc/systemd/system/cybex-james-first-boot.service.d/90-pxe-dev.conf": (
        "51fcd831585f61ea23af68c34d5359c0a85e51a542a5a6253e724bdc1e9ff859",
        {"opt/cybex-pxe-dev/autoexec.ipxe": PXE_ASSET},
    ),
}


def retire_one(root, relative, known_files):
    override = root / relative
    if not override.exists() and not override.is_symlink():
        return False
    metadata = override.lstat()
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1
            or metadata.st_uid != os.geteuid() or metadata.st_mode & 0o022):
        raise ValueError("Unsafe development service override")
    content = override.read_bytes()
    known = known_files.get(hashlib.sha256(content).hexdigest())
    if known is None:
        return False
    # A modified repair binary may contain operator work not in this release.
    # Preserve its override rather than silently replacing that work.
    for relative_file, hashes in known.items():
        binary = root / relative_file
        if not binary.is_file() or binary.is_symlink():
            return False
        with binary.open("rb") as stream:
            if hashlib.file_digest(stream, "sha256").hexdigest() not in hashes:
                return False
    archive = override.with_suffix(".conf.retired")
    if archive.exists() or archive.is_symlink():
        if archive.is_symlink() or archive.read_bytes() != content:
            raise ValueError("Conflicting retired service override")
    else:
        fd = os.open(archive, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "wb") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
    if override.read_bytes() != content or override.stat().st_ino != metadata.st_ino:
        raise ValueError("Development service override changed concurrently")
    override.unlink()
    fd = os.open(override.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)
    return True


def retire(root=Path("/")):
    # Check before retiring any override: a partially retired stack must never
    # allow a known incompatible predecessor to pass package configuration.
    override = root / "etc/systemd/system/cybex-james.service.d/90-verification-fix.conf"
    if override.is_file() and not override.is_symlink():
        rule = KNOWN.get(hashlib.sha256(override.read_bytes()).hexdigest())
        if rule:
            binary = root / rule[0]
            if binary.is_file():
                with binary.open("rb") as stream:
                    identity = hashlib.file_digest(stream, "sha256").hexdigest()
                if identity in UNSAFE_PREDECESSORS:
                    raise ValueError("Install the database-compatible predecessor repair before this upgrade")
    changed = False
    # Retire older layers first; removing only the later override would expose
    # the older ExecStart and silently keep the package from running.
    for relative, (identity, files) in PXE.items():
        changed = retire_one(root, relative, {identity: {p: {h} for p, h in files.items()}}) or changed
    known = {identity: {path: hashes} for identity, (path, hashes) in KNOWN.items()}
    return retire_one(root, "etc/systemd/system/cybex-james.service.d/90-verification-fix.conf", known) or changed


if __name__ == "__main__":
    if os.geteuid() != 0:
        raise SystemExit("Packaged service activation requires root")
    if retire():
        print("Retired the known development daemon override in this root generation")
