#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

result="$(/usr/lib/tiaris-nest/tiaris-nest-bootstrap reconcile-network-runtime)"
case "$result" in
  unchanged|changed) ;;
  *)
    echo "network runtime reconciliation returned an invalid outcome" >&2
    exit 1
    ;;
esac

nest_state="$(systemctl show --property=ActiveState --value tiaris-nest.service)"
case "$nest_state" in
  active)
    if [[ "$result" = changed ]]; then
      # Queue rather than wait on the unit ordered after this prerequisite.
      systemctl --no-block try-restart tiaris-nest.service
    fi
    ;;
  inactive|failed)
    # A failed initial prerequisite leaves Nest down. A later successful timer
    # reconciliation must make the appliance self-heal without operator input.
    systemctl --no-block start tiaris-nest.service
    ;;
  activating|deactivating|reloading)
    # Nest already has a converging job. Starting it again from its own
    # prerequisite would create a needless transaction loop.
    ;;
  *)
    echo "Nest service returned an invalid ActiveState" >&2
    exit 1
    ;;
esac
